APP_NAME=Marketplace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public URL of the API: signed e-mail verification links point here.
APP_URL=http://127.0.0.1:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# compose.yml overrides DB_HOST to "postgres" inside the containers.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=marketplace
DB_USERNAME=marketplace
# Local development only; use a strong secret anywhere else.
DB_PASSWORD=marketplace

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail via Resend (https://resend.com). Without an API key keep "log": messages go to storage/logs.
# onboarding@resend.dev only delivers to your own Resend account e-mail; verify a domain to send to anyone.
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"

# Client app that receives the password reset link (FRONTEND_URL/redefinir-senha?token=...&email=...).
FRONTEND_URL=http://localhost:3000

# Google login (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application").
# The redirect URI below must be listed exactly in "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mock payment gateway. The webhook rejects every request while the secret is empty.
PAYMENTS_MOCK_WEBHOOK_SECRET=
PAYMENTS_MOCK_PIX_TTL_MINUTES=30
PAYMENTS_MOCK_BOLETO_DUE_DAYS=3
PAYMENTS_MOCK_CHECKOUT_URL=https://mock-payments.local/checkout
# Commission when no platform_fee_rules row is in effect (basis points: 1000 = 10%).
PLATFORM_COMMISSION_BPS=1000

# Minutes an unpaid order keeps its stock reserved (Pix and boleto extend it).
ORDERS_UNPAID_TTL_MINUTES=60

SHIPPING_DEFAULT_SERVICE=simulated_standard
SHIPPING_DEFAULT_ORIGIN_CEP=01310100

POST_SALE_DISPUTE_WINDOW_DAYS=7
POST_SALE_RETURN_WINDOW_DAYS=7

VITE_APP_NAME="${APP_NAME}"
